<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The Flink framework module. It is the root pom of the repository (sources under src/,
         shaded jar under target/) and a module of the reactor in reactor/pom.xml, which is also
         its parent: groupId, version, the Java 21 / Maven 3.9 enforcer rules and plugin versions
         come from there. `./mvnw clean test` here builds this module alone;
         `./mvnw -f reactor/pom.xml verify` builds every module in dependency order. -->
    <parent>
        <groupId>org.jagentic</groupId>
        <artifactId>agentic-streaming-reactor</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>reactor/pom.xml</relativePath>
    </parent>

    <artifactId>agentic-flink</artifactId>

    <name>Agentic Flink</name>
    <description>The agentic/v1 runtime on Apache Flink</description>

    <properties>
        <!-- flink.version, java.version, langchain4j.version and junit.version are inherited from
             the reactor parent. Flink 2.x supports 17/21; 25 is not yet viable (see the Lombok
             note below). slf4j.version and log4j.version come from the reactor too. -->
        <!-- JVM flags for the surefire and failsafe forks. Flink on Java 17+: Kryo / Twitter Chill
             reflective access into JDK internals is blocked by the module system without these
             opens. Mirrors Flink's own recommended JVM args. -->
        <agentic.test.jvmArgs>
            --add-opens=java.base/java.util=ALL-UNNAMED
            --add-opens=java.base/java.lang=ALL-UNNAMED
            --add-opens=java.base/java.lang.invoke=ALL-UNNAMED
            --add-opens=java.base/java.lang.reflect=ALL-UNNAMED
            --add-opens=java.base/java.io=ALL-UNNAMED
            --add-opens=java.base/java.net=ALL-UNNAMED
            --add-opens=java.base/java.nio=ALL-UNNAMED
            --add-opens=java.base/sun.nio.ch=ALL-UNNAMED
            --add-opens=java.base/sun.nio.cs=ALL-UNNAMED
            --add-opens=java.base/sun.security.action=ALL-UNNAMED
            --add-opens=java.base/sun.util.calendar=ALL-UNNAMED
            --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED
            --add-opens=java.base/java.text=ALL-UNNAMED
        </agentic.test.jvmArgs>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- flink-connector-kafka 5.0.0-2.2 is built on the 4.1 line; 4.1.2 is that line's patch
                 for CVE-2026-33557 and CVE-2026-35554. agentic-pekko stays on 3.9.2 through its
                 connector, so this is not managed in the reactor. -->
            <dependency>
                <groupId>org.apache.kafka</groupId>
                <artifactId>kafka-clients</artifactId>
                <version>4.1.2</version>
            </dependency>
            <!-- Test scope only, both through flink-test-utils. -->
            <dependency>
                <groupId>org.apache.zookeeper</groupId>
                <artifactId>zookeeper</artifactId>
                <version>3.9.7</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>3.27.7</version>
            </dependency>
            <!-- The LangChain4J BOM, flink-cep and postgresql versions, Jackson and Netty, and every
                 org.jagentic module coordinate are managed in reactor/pom.xml. -->
            <!-- Pin commons-lang3 to the modern version Flink 2.x ships, so neither the uber-jar
                 nor downstream consumers pick up a stale Range/StringUtils from a transitive dep
                 (a pre-3.13 commons-lang3 lacks Range.of and breaks Flink's runtime). -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>3.19.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Apache Flink Core -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-clients</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Flink CEP. Deliberately compile scope, unlike the rest of Flink: the pipeline runner
             uses it, and a Flink distribution does not ship flink-cep in lib/, so every consumer
             job jar has to shade it. `provided` would fail those jobs at runtime with
             NoClassDefFoundError. It adds no transitive dependencies beyond the provided Flink
             runtime. -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-cep</artifactId>
        </dependency>

        <!-- The Flink-free portable agent brain (RoutedGraph, GraphBuilder, PipelineLoader, tools,
             CEP spec). Lets the YAML->Flink-job runner reuse the same pipeline.yaml the cores use,
             running the portable graph inside a Flink keyed operator. A reactor module: the
             reactor build orders it first, a standalone build of this pom needs it installed
             (`./mvnw -f ports/jagentic-core/pom.xml install -DskipTests`). -->
        <dependency>
            <groupId>org.jagentic</groupId>
            <artifactId>jagentic-core</artifactId>
        </dependency>
        <dependency>
          <groupId>org.jagentic</groupId>
          <artifactId>jagentic-core</artifactId>
          <version>${project.version}</version>
          <type>test-jar</type>
          <scope>test</scope>
        </dependency>

        <!-- LangChain4J provider SDKs, behind the core's `embeddings: {provider: ollama|openai}`.
             Optional, as in jagentic-core: a consumer of the thin jar adds the one it configures
             (see the install section of README.md). The uber jar carries both. -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-ollama</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- The provider SDKs bring this at runtime scope only, so anything run on the compile
             classpath (exec:java with classpathScope=compile) failed with "No HTTP client has
             been found". Version from the langchain4j BOM. -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-http-client-jdk</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Logging: the library logs through the SLF4J API only. The Log4j backend is test scope,
             so consumers (and the thin jar's pom) choose their own binding; the uber jar excludes
             both (a Flink cluster supplies them). -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>${log4j.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Flink Kafka connector for KafkaPipelineJob. A Flink distribution does not ship it. -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-kafka</artifactId>
            <version>5.0.0-2.2</version>
        </dependency>
        <!-- DeliveryGuarantee for the Kafka sink. Ships in the Flink distribution. -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-base</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jackson for JSON and YAML Support -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <!-- Jackson Parameter Names Module for constructor detection -->
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-parameter-names</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC driver, behind the core's `vector_store: {kind: pgvector}`. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-test-utils</artifactId>
            <version>${flink.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- env.fromData (the runner's seed event) needs it at run time, and MiniCluster tests use
             it as an unbounded in-JVM source for stop-with-savepoint and restore -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-datagen</artifactId>
            <version>${flink.version}</version>
        </dependency>

        <!-- Keyed operator test harness (event-time timers, TTL, snapshot/restore without a cluster) -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <version>${flink.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-runtime</artifactId>
            <version>${flink.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- @SetEnvironmentVariable for AgenticFlinkConfig env resolution tests. Its own JUnit
             artifacts are excluded so the reactor's junit.version stays authoritative; the
             surefire argLine already opens java.util and java.lang for the env map access. -->
        <dependency>
            <groupId>org.junit-pioneer</groupId>
            <artifactId>junit-pioneer</artifactId>
            <version>2.3.0</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.junit.platform</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- The JDK 21 / Maven 3.9 enforcer rules are inherited from reactor/pom.xml. -->

            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Maven Shade Plugin for Uber JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.plugin.shade.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!--
                            Attach the fat jar under the `uber` classifier and keep the MAIN
                            artifact thin. Maven consumers of agentic-flink then get the plain
                            classes + correct transitive deps
                            (e.g. commons-lang3 3.19.0) instead of a 260MB uber-jar that bundles —
                            and accidentally shadows with — stale third-party classes. Use the
                            `-uber` jar for `flink run` / cluster upload.
                            -->
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>uber</shadedClassifierName>
                            <!-- The installed pom must be this pom, not shade's dependency-reduced
                                 one: the reduced pom strips every dependency bundled into the
                                 uber jar, which is exactly the compile-scope set (jagentic-core,
                                 langchain4j, flink-cep, Jackson) a consumer of the thin jar needs. -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <excludes>
                                    <exclude>org.apache.flink:flink-shaded-force-shading</exclude>
                                    <exclude>com.google.code.findbugs:jsr305</exclude>
                                    <exclude>org.slf4j:*</exclude>
                                    <exclude>org.apache.logging.log4j:*</exclude>
                                </excludes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.agentic.flink.pipeline.FlinkPipelineRunner</mainClass>
                                </transformer>
                                <!-- Merge META-INF/services, which shade otherwise keeps one of per service. -->
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Maven Surefire Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>${agentic.test.jvmArgs}</argLine>
                </configuration>
            </plugin>

            <!-- Google Java Format. The default lifecycle only verifies formatting; run
                 `./mvnw spotless:apply` to rewrite sources (CONTRIBUTING.md). -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.43.0</version>
                <configuration>
                    <java>
                        <googleJavaFormat/>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>central</id>
            <name>Central Repository</name>
            <url>https://repo1.maven.org/maven2/</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <profiles>

        <!--
        Examples profile. Flink is a provided dependency, so a plain `exec:java` run lacks
        org.apache.flink.streaming.*, and even with the test-scope classpath the in-process
        exec:java run fails because Flink's MiniCluster deserializes the stream graph through a
        class loader that cannot see the plugin's isolated classpath. This profile therefore forks
        a JVM (exec:exec) with the test-scope classpath (which includes provided) and the same
        reflective opens as the surefire argLine. `compile` must be in the same invocation:

            ./mvnw -P examples compile exec:exec -Dexec.mainClass=org.agentic.flink.pipeline.FlinkPipelineRunner \
                -Dexec.args="examples/pipelines/incident.yaml"

        -->
        <profile>
            <id>examples</id>
            <properties>
                <exec.args></exec.args>
                <examples.add.opens>--add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.lang.invoke=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.net=ALL-UNNAMED --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/sun.nio.ch=ALL-UNNAMED --add-opens=java.base/sun.nio.cs=ALL-UNNAMED --add-opens=java.base/sun.security.action=ALL-UNNAMED --add-opens=java.base/sun.util.calendar=ALL-UNNAMED --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED --add-opens=java.base/java.text=ALL-UNNAMED</examples.add.opens>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <classpathScope>test</classpathScope>
                            <commandlineArgs>${examples.add.opens} -classpath %classpath ${exec.mainClass} ${exec.args}</commandlineArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

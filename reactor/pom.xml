<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.jagentic</groupId>
    <artifactId>agentic-streaming-reactor</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Agentic Streaming reactor</name>
    <description>Parent and aggregator for every first-class JVM module of Agentic Streaming.
        `./mvnw -f reactor/pom.xml verify` from the repository root builds the whole tree in
        dependency order; each module still builds on its own with `./mvnw -f MODULE/pom.xml`
        once its upstream modules are installed.</description>
    <url>https://github.com/Ugbot/Agentic-Streaming</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Ugbot</id>
            <name>Ben Gamble</name>
            <url>https://github.com/Ugbot</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/Ugbot/Agentic-Streaming.git</connection>
        <developerConnection>scm:git:git@github.com:Ugbot/Agentic-Streaming.git</developerConnection>
        <url>https://github.com/Ugbot/Agentic-Streaming</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/Ugbot/Agentic-Streaming/issues</url>
    </issueManagement>

    <!--
    Layout decision (C1). The root pom.xml stays the Flink framework module (its sources live at
    src/, its shaded jar at target/agentic-flink-*-uber.jar, and python/, pyflink/, the compose
    files and every documented `./mvnw ...` command at the repository root depend on that). The
    aggregator therefore lives here, one level down, and lists the root module as "..".
    Every module names this pom as its parent through <relativePath>, so no install of the parent
    is needed before a single module can be built. When a module is installed on its own
    (`./mvnw -f ports/jagentic-core/pom.xml install -DskipTests`, the documented first step in
    many READMEs) this parent is installed alongside it (see the maven-install-plugin execution
    below): the module's installed pom names this parent, and a downstream `-f MODULE/pom.xml`
    build resolves that parent from the local repository, not through <relativePath>.

    One groupId (org.jagentic) and one version (1.0.0-SNAPSHOT) for the whole reactor. The
    framework jar keeps its artifactId, so the file name agentic-flink-1.0.0-SNAPSHOT-uber.jar
    the Python packages glob for is unchanged. Java package names (org.agentic.flink.*,
    org.jagentic.*) are unaffected by the Maven groupId.

    ports/experimental/* are advisory adapters and are deliberately not modules of this reactor.
    -->

    <modules>
        <module>../ports/jagentic-core</module>
        <module>..</module>
        <module>../agentic-pekko</module>
        <module>../pyflink/java</module>
        <module>../tool-services/tool-services-packs</module>
        <module>../tool-services/tool-services-app</module>
        <module>../banking-job</module>
    </modules>

    <properties>
        <!-- Java 21 is the baseline for every JVM module (AGS-13). -->
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <flink.version>2.2.1</flink.version>
        <langchain4j.version>1.16.3</langchain4j.version>
        <junit.version>5.10.2</junit.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <quarkus.platform.version>3.30.6</quarkus.platform.version>
        <postgresql.version>42.7.13</postgresql.version>
        <hikaricp.version>5.0.1</hikaricp.version>
        <!-- SLF4J 2.x API line; the matching log4j binding is log4j-slf4j2-impl (log4j 2.19+). -->
        <slf4j.version>2.0.17</slf4j.version>
        <log4j.version>2.24.3</log4j.version>

        <maven.plugin.compiler.version>3.13.0</maven.plugin.compiler.version>
        <maven.plugin.surefire.version>3.2.5</maven.plugin.surefire.version>
        <maven.plugin.enforcer.version>3.5.0</maven.plugin.enforcer.version>
        <maven.plugin.jar.version>3.4.2</maven.plugin.jar.version>
        <maven.plugin.shade.version>3.6.0</maven.plugin.shade.version>
        <maven.plugin.exec.version>3.2.0</maven.plugin.exec.version>
        <maven.plugin.install.version>3.1.4</maven.plugin.install.version>
        <maven.plugin.source.version>3.3.1</maven.plugin.source.version>
        <maven.plugin.javadoc.version>3.11.2</maven.plugin.javadoc.version>

        <!-- Javadoc lint level for the -javadoc.jar built with every module. The default keeps
             the jar building on modules whose comments still have lint errors; the strict-javadoc
             profile below turns those into build failures. -->
        <javadoc.doclint>none</javadoc.doclint>
        <javadoc.failOnError>false</javadoc.failOnError>
        <javadoc.failOnWarnings>false</javadoc.failOnWarnings>
        <!-- The optional Flink Agents plugin under the root module is excluded from compilation
             unless the flink-agents profile is active (root pom.xml, maven-compiler-plugin); the
             Javadoc run must skip the same sources or it fails on their unresolved imports. -->
        <javadoc.sourceFileExclude>**/plugins/flintagents/**</javadoc.sourceFileExclude>
    </properties>

    <!-- Every cross-module coordinate is managed here, so no module states another module's
         version: a module declares `org.jagentic:agentic-flink` with no <version>. Consumers
         outside the reactor (ports/experimental/*) import this pom as a BOM instead of
         inheriting from it. The LangChain4J BOM, flink-cep and the postgres/Hikari versions
         are managed here too: the Flink framework (root pom) marks the provider SDKs and the
         postgres driver/pool optional, so the modules that need them at runtime (banking-job,
         a2a-gateway) declare them explicitly and must resolve to the same versions. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-bom</artifactId>
                <version>${log4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jagentic</groupId>
                <artifactId>jagentic-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jagentic</groupId>
                <artifactId>agentic-flink</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jagentic</groupId>
                <artifactId>agentic-flink</artifactId>
                <version>${project.version}</version>
                <classifier>uber</classifier>
            </dependency>
            <dependency>
                <groupId>org.jagentic</groupId>
                <artifactId>agentic-pekko</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jagentic</groupId>
                <artifactId>agentic-pyflink</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jagentic</groupId>
                <artifactId>tool-services-packs</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jagentic</groupId>
                <artifactId>tool-services-app</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jagentic</groupId>
                <artifactId>agentic-flink-banking-job</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jagentic</groupId>
                <artifactId>agentic-flink-a2a-gateway</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-cep</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>${hikaricp.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.plugin.compiler.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.plugin.surefire.version}</version>
                </plugin>
                <!-- Integration tests live in *IT.java classes and run through failsafe only, so
                     the default surefire run (whose include pattern does not match *IT.java)
                     never discovers them and the integration-tests profile below never runs
                     them twice. Failsafe shares surefire's version line. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven.plugin.surefire.version}</version>
                    <configuration>
                        <includes>
                            <include>**/*IT.java</include>
                        </includes>
                    </configuration>
                    <executions>
                        <execution>
                            <id>integration-tests</id>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven.plugin.enforcer.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven.plugin.jar.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven.plugin.shade.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${maven.plugin.exec.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven.plugin.install.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven.plugin.source.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven.plugin.javadoc.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Fail fast, with a readable message, if the build JDK or Maven is too old. Declared
                 once here and inherited by every module, so a module built on its own with
                 `./mvnw -f MODULE/pom.xml` is checked the same way as the full reactor. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                    <message>This project builds on JDK 21 (the baseline; see docs/audit-backlog.md, AGS-13/AGS-14). Newer JDKs are not part of the tested baseline yet.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                    <message>Use the committed wrapper (./mvnw) or Maven 3.9+.</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Install this parent pom together with any module that is installed on its own, so
                 the per-module `./mvnw -f MODULE/pom.xml ...` commands keep working after
                 `./mvnw -f ports/jagentic-core/pom.xml install -DskipTests` (the installed
                 jagentic-core pom refers to this parent by coordinates). Inside a reactor build
                 this re-installs the same file the reactor's own install step wrote. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <executions>
                    <execution>
                        <id>install-reactor-parent</id>
                        <phase>install</phase>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                        <configuration>
                            <file>${maven.multiModuleProjectDirectory}/reactor/pom.xml</file>
                            <pomFile>${maven.multiModuleProjectDirectory}/reactor/pom.xml</pomFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Every jar module also produces MODULE-VERSION-sources.jar and MODULE-VERSION-javadoc.jar
                 at package time (both goals skip pom packaging). Doclint is controlled by the
                 javadoc.* properties above; `-P strict-javadoc` fails the build on Javadoc errors. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <doclint>${javadoc.doclint}</doclint>
                    <failOnError>${javadoc.failOnError}</failOnError>
                    <failOnWarnings>${javadoc.failOnWarnings}</failOnWarnings>
                    <sourceFileExcludes>
                        <sourceFileExclude>${javadoc.sourceFileExclude}</sourceFileExclude>
                    </sourceFileExcludes>
                    <quiet>true</quiet>
                    <notimestamp>true</notimestamp>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Javadoc as a gate: every doclint group except `missing` (undocumented members are not
             an error here), and any error fails the build.
                 ./mvnw -f reactor/pom.xml -DskipTests -P strict-javadoc package -pl ../ports/jagentic-core -->
        <profile>
            <id>strict-javadoc</id>
            <properties>
                <javadoc.doclint>all,-missing</javadoc.doclint>
                <javadoc.failOnError>true</javadoc.failOnError>
                <javadoc.failOnWarnings>true</javadoc.failOnWarnings>
            </properties>
        </profile>

        <!-- Companion of the root module's flink-agents profile (same id, activated by the same
             -P flag): when the plugin sources are compiled they are documented as well. -->
        <profile>
            <id>flink-agents</id>
            <properties>
                <javadoc.sourceFileExclude>NOTHING_TO_EXCLUDE</javadoc.sourceFileExclude>
            </properties>
        </profile>

        <!-- Runs the *IT.java classes of every module through maven-failsafe-plugin in the
             integration-test and verify phases, on top of the unit suite:
                 ./mvnw -f reactor/pom.xml verify -P integration-tests
             The classes start the services they need (PostgreSQL, pgvector, Redis, Qdrant,
             Fluss) through Testcontainers and fail with an explicit message when no container
             runtime is reachable; they never skip themselves. Locally that runtime is Podman:
                 export DOCKER_HOST=unix:///run/user/$(id -u)/podman/podman.sock
                 export TESTCONTAINERS_RYUK_DISABLED=true
             See docs/testing.md. -->
        <profile>
            <id>integration-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- The Quarkus A2A gateway is part of the reactor but opt-in: it is the slowest module
             (Quarkus augmentation plus its own Flink stack) and nothing else depends on it.
                 ./mvnw -f reactor/pom.xml -P a2a-gateway verify -->
        <profile>
            <id>a2a-gateway</id>
            <modules>
                <module>../a2a-gateway</module>
            </modules>
        </profile>
    </profiles>
</project>

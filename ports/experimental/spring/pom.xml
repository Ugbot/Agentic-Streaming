<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>org.jagentic.ports</groupId>
  <artifactId>agentic-spring</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>agentic-spring</name>
  <description>Spring port of the Agentic-Flink essence, reusing the pure-Java
    jagentic-core (no Flink). Inbound REST edge + Spring Integration EIP topology
    (router -> path channels -> verifier) over the shared RoutedGraph.</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <agentic.version>1.0.0-SNAPSHOT</agentic.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Version of every org.jagentic module (jagentic-core here) comes from the reactor
           pom imported as a BOM, so this adapter never states a core version. It needs the
           reactor installed locally: `./mvnw -f reactor/pom.xml -DskipTests install`. -->
      <dependency>
        <groupId>org.jagentic</groupId>
        <artifactId>agentic-streaming-reactor</artifactId>
        <version>${agentic.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- The shared pure-Java core. No Flink dependency. -->
    <dependency>
      <groupId>org.jagentic</groupId>
      <artifactId>jagentic-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Spring Integration: the routed graph as a literal EIP topology
         (router -> path channels -> verifier). -->
    <dependency>
      <groupId>org.springframework.integration</groupId>
      <artifactId>spring-integration-core</artifactId>
    </dependency>

    <!-- Spring StateMachine: the agent phase FSM. Pinned explicitly since it is
         not managed by the Boot 3.3 BOM. -->
    <dependency>
      <groupId>org.springframework.statemachine</groupId>
      <artifactId>spring-statemachine-core</artifactId>
      <version>4.0.0</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>enforce-jdk-and-maven</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.jagentic.ports</groupId>
  <artifactId>agentic-kafka-streams</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>Agentic-Flink :: Kafka Streams port</name>
  <description>
    Minimal port of the Agentic-Flink essence onto Kafka Streams (Processor API),
    reusing the pure-Java core org.jagentic:jagentic-core with NO Flink dependency.
  </description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <agentic.version>1.0.0-SNAPSHOT</agentic.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <kafka.version>3.8.0</kafka.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Version of every org.jagentic module (jagentic-core here) comes from the reactor
           pom imported as a BOM, so this adapter never states a core version. It needs the
           reactor installed locally: `./mvnw -f reactor/pom.xml -DskipTests install`. -->
      <dependency>
        <groupId>org.jagentic</groupId>
        <artifactId>agentic-streaming-reactor</artifactId>
        <version>${agentic.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- The shared, engine-agnostic, pure-Java core. No Flink. -->
    <dependency>
      <groupId>org.jagentic</groupId>
      <artifactId>jagentic-core</artifactId>
    </dependency>

    <!-- The engine: Kafka Streams (Processor API). -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-streams</artifactId>
      <version>${kafka.version}</version>
    </dependency>

    <!-- TopologyTestDriver: run the topology with no broker. -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-streams-test-utils</artifactId>
      <version>${kafka.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>enforce-jdk-and-maven</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>

      <!-- `mvn -f ports/experimental/kafka-streams/pom.xml exec:java` prints the topology. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <mainClass>org.jagentic.ports.kafkastreams.BankingTopology</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

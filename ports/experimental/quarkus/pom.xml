<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.jagentic.ports</groupId>
  <artifactId>agentic-quarkus</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>agentic-quarkus</name>
  <description>Minimal Quarkus (reactive) port of the Agentic-Flink essence over the
    shared pure-Java jagentic-core. Inbound REST edge + Kafka streaming agent,
    no Flink dependency.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <agentic.version>1.0.0-SNAPSHOT</agentic.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.version>3.30.6</quarkus.platform.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Version of every org.jagentic module (jagentic-core here) comes from the reactor
           pom imported as a BOM, so this adapter never states a core version. It needs the
           reactor installed locally: `./mvnw -f reactor/pom.xml -DskipTests install`. -->
      <dependency>
        <groupId>org.jagentic</groupId>
        <artifactId>agentic-streaming-reactor</artifactId>
        <version>${agentic.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- The shared, engine-agnostic pure-Java core. No Flink. -->
    <dependency>
      <groupId>org.jagentic</groupId>
      <artifactId>jagentic-core</artifactId>
    </dependency>

    <!-- CDI / bean container -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>

    <!-- Reactive REST (the inbound edge) + Jackson JSON -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>

    <!-- SmallRye Reactive Messaging core + the Kafka connector (the streaming edge).
         quarkus-messaging is the reactive-messaging core; quarkus-messaging-kafka adds
         the Kafka connector. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-messaging</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-messaging-kafka</artifactId>
    </dependency>

    <!-- Tests: @QuarkusTest boots the real application; the REST edge is driven with
         RestAssured and the Kafka channels are switched to the in-memory connector by the
         %test profile in application.properties, so no broker is needed. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.smallrye.reactive</groupId>
      <artifactId>smallrye-reactive-messaging-in-memory</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Same build-environment gate as reactor/pom.xml: this module is outside the reactor,
           so it declares the rule itself. The verify-phase execution is the packaging check:
           it fails unless the Quarkus build produced the runnable fast-jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                  <message>This project requires JDK 21 or newer.</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                  <message>Use the committed wrapper (./mvnw) or Maven 3.9+.</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>verify-quarkus-package</id>
            <phase>verify</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireFilesExist>
                  <files>
                    <file>${project.build.directory}/quarkus-app/quarkus-run.jar</file>
                    <file>${project.build.directory}/quarkus-app/lib/main/org.jagentic.jagentic-core-1.0.0-SNAPSHOT.jar</file>
                  </files>
                  <message>quarkus-maven-plugin did not produce target/quarkus-app; the module cannot be packaged.</message>
                </requireFilesExist>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Plain javac compile is the hard requirement; release 21. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>21</release>
        </configuration>
      </plugin>
      <!-- Builds the runnable application (target/quarkus-app) in the package phase and
           augments the test classpath for @QuarkusTest. -->
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <maven.home>${maven.home}</maven.home>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
